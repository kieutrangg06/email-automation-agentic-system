    {
      "parameters": {
        "jsCode": "const deadline = new Date();\ndeadline.setHours(deadline.getHours() + 2);\n\nreturn [{\n  json: {\n    ticket_code: $(\"6. Format Markdown Code\").first().json.ticket_code,\n    first_response_sla: deadline.toISOString()\n  }\n}];"
      },
