{
  "name": "Luồng 2 - AI Email-to-Ticket Generator with SLA Assignment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incoming-ticket-trigger",
        "responseMode": "onReceived",
        "responseData": "OK",
        "options": {}
      },
      "id": "w2-node-1",
      "name": "1. Webhook Ticket Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body ? item.body : item;\n\nconst sender = payload.sender_email || payload.from || \"guest@enterprise.com\";\nconst subject = payload.subject || \"Yêu cầu hỗ trợ kỹ thuật\";\nconst body = payload.clean_body || payload.text || payload.body || \"Không có nội dung chi tiết\";\nconst category = payload.category || \"Technical\";\nconst priority = payload.priority || \"P1 - Critical\";\n\nreturn [{\n  json: {\n    sender_email: sender,\n    title: subject,\n    raw_description: body,\n    category: category,\n    priority: priority\n  }\n}];"
      },
      "id": "w2-node-2",
      "name": "2. Clean Payload Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const randomNum = Math.floor(1000 + Math.random() * 9000);\nconst ticketCode = `TICK-2026-${randomNum}`;\nconst current = $input.first().json;\n\nreturn [{\n  json: {\n    ...current,\n    ticket_code: ticketCode,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "w2-node-3",
      "name": "3. Gen Ticket Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT name, email FROM support_agents WHERE category = $1 AND status = 'AVAILABLE' ORDER BY active_tickets_count ASC LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.category] }}"
        }
      },
      "id": "w2-node-4",
      "name": "4. Query Available Agents Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        860,
        300
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $env.GEMINI_API_KEY || "YOUR_GEMINI_API_KEY" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{\n    parts: [{\n      text: `Tóm tắt sự cố này thành đúng 2 gạch đầu dòng ngắn gọn:\\nTiêu đề: ${$(\"3. Gen Ticket Code\").first().json.title}\\nNội dung: ${$(\"3. Gen Ticket Code\").first().json.raw_description}`\n    }]\n  }]\n}) }}",
        "options": {}
      },
      "id": "w2-node-5",
      "name": "5. AI Summarize Issue Code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1080,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $(\"3. Gen Ticket Code\").first().json;\nconst agentData = $(\"4. Query Available Agents Postgres\").first().json;\nlet summary = \"\";\n\ntry {\n  summary = $input.first().json.candidates[0].content.parts[0].text.trim();\n} catch (e) {\n  summary = `- Tiếp nhận sự cố kỹ thuật: ${base.title}\\n- Đang xử lý tự động qua hệ thống`;\n}\n\nconst assignedName = (agentData && agentData.name) ? agentData.name : \"Nguyễn Văn An (Kỹ thuật)\";\nconst assignedEmail = (agentData && agentData.email) ? agentData.email : \"an.nguyen@enterprise.vn\";\n\nreturn [{\n  json: {\n    ticket_code: base.ticket_code,\n    sender_email: base.sender_email,\n    title: base.title,\n    description: base.raw_description,\n    summary: summary,\n    category: base.category,\n    priority: base.priority,\n    assigned_to: assignedName,\n    agent_email: assignedEmail\n  }\n}];"
      },
      "id": "w2-node-6",
      "name": "6. Format Markdown Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4000/api/v1/triage/tickets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "w2-node-7",
      "name": "7. Call NestJS POST /tickets HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1520,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\n// Kiểm tra response từ NestJS: hoặc có ticket hoặc có status là created\nconst isSuccess = (res && (res.status === 'created' || res.ticket !== undefined || res.statusCode === undefined));\n\nreturn [{\n  json: {\n    success: isSuccess ? \"YES\" : \"NO\",\n    api_response: res\n  }\n}];"
      },
      "id": "w2-node-8",
      "name": "8. Validate Ticket Creation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.success }}",
              "operation": "equal",
              "value2": "YES"
            }
          ]
        }
      },
      "id": "w2-node-8-if",
      "name": "8.1. IF API Created",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1940,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO system_audit_logs (event_type, payload) VALUES ($1, $2::jsonb);",
        "options": {
          "queryReplacement": "={{ [\"TICKET_CREATED_SUCCESS\", JSON.stringify($(\"6. Format Markdown Code\").first().json)] }}"
        }
      },
      "id": "w2-node-9",
      "name": "9. Audit Ticket Created Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        2180,
        200
      ],
      "credentials": {
        "postgres": {
