      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3280,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets SET first_response_sla = $1 WHERE ticket_code = $2 RETURNING *;",
        "options": {
