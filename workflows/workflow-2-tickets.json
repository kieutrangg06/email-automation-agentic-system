        "query": "INSERT INTO system_audit_logs (event_type, payload) VALUES ($1, $2::jsonb);",
        "options": {
          "queryReplacement": "={{ [\"AGENT_ASSIGNED\", JSON.stringify({ ticket: $(\"6. Format Markdown Code\").first().json.ticket_code, agent: $(\"6. Format Markdown Code\").first().json.assigned_to })] }}"
        }
