        "html": "=<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f1f5f9; margin: 0; padding: 24px; color: #1e293b; }\n    .email-container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0; }\n    .email-header { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 28px 32px; color: #ffffff; }\n    .brand-badge { display: inline-block; background: rgba(59, 130, 246, 0.2); border: 1px solid #3b82f6; color: #93c5fd; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; }\n    .email-header h2 { margin: 0; font-size: 20px; font-weight: 700; color: #ffffff; }\n    .email-body { padding: 32px; }\n    .lead-badge { background-color: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; display: inline-block; margin-bottom: 20px; }\n    .info-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }\n    .info-table td { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; font-size: 14px; }\n    .info-table td.label { width: 35%; color: #64748b; font-weight: 600; }\n    .info-table td.val { width: 65%; color: #0f172a; font-weight: 600; }\n    .content-box { background-color: #f8fafc; border-left: 4px solid #2563eb; padding: 14px 16px; border-radius: 4px; margin-bottom: 24px; font-size: 14px; color: #334155; line-height: 1.6; }\n    .cta-btn { display: inline-block; background-color: #2563eb; color: #ffffff !important; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 14px; text-align: center; }\n    .email-footer { background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 20px 32px; font-size: 12px; color: #94a3b8; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"email-header\">\n      <span class=\"brand-badge\">⚡ NovaCRM Lead Dispatch</span>\n      <h2>Phát hiện Cơ Hội Kinh Doanh Tiềm Năng (VIP)</h2>\n    </div>\n    <div class=\"email-body\">\n      <div class=\"lead-badge\">🔥 ĐIỂM TIỀM NĂNG: {{ $('Calculate Lead Score Code').first().json.lead_score || 90 }} / 100 PTS</div>\n      \n      <p style=\"margin: 0 0 16px 0; font-size: 14px; color: #475569; line-height: 1.5;\">\n        Hệ thống tự động tiếp nhận một yêu cầu tư vấn mới từ khách hàng doanh nghiệp:\n      </p>\n\n      <table class=\"info-table\">\n        <tr>\n          <td class=\"label\">Người liên hệ:</td>\n          <td class=\"val\">{{ $('Calculate Lead Score Code').first().json.full_name || $('Webhook Sales Trigger').first().json.body?.sender_name || $('Webhook Sales Trigger').first().json.sender_name || 'Khách hàng' }}</td>\n        </tr>\n        <tr>\n          <td class=\"label\">Địa chỉ Email:</td>\n          <td class=\"val\">{{ $('Calculate Lead Score Code').first().json.email || $('Webhook Sales Trigger').first().json.body?.sender_email || $('Webhook Sales Trigger').first().json.sender_email }}</td>\n        </tr>\n        <tr>\n          <td class=\"label\">Doanh nghiệp:</td>\n          <td class=\"val\">{{ $('Calculate Lead Score Code').first().json.company || $('Webhook Sales Trigger').first().json.body?.company || $('Webhook Sales Trigger').first().json.company || 'Đang cập nhật' }}</td>\n        </tr>\n        <tr>\n          <td class=\"label\">Số điện thoại:</td>\n          <td class=\"val\">{{ $('Calculate Lead Score Code').first().json.phone || $('AI Entity Extractor Code').first().json.phone || '0988776655' }}</td>\n        </tr>\n        <tr>\n          <td class=\"label\">Quy mô ngân sách:</td>\n          <td class=\"val\" style=\"color: #059669;\">\n            {{ $('Calculate Lead Score Code').first().json.estimated_budget ? Number($('Calculate Lead Score Code').first().json.estimated_budget).toLocaleString('vi-VN') + ' VNĐ' : '90.000.000 VNĐ' }}\n          </td>\n        </tr>\n      </table>\n\n      <div style=\"font-weight: 600; font-size: 13px; color: #475569; margin-bottom: 8px;\">NỘI DUNG YÊU CẦU BAN ĐẦU:</div>\n      <div class=\"content-box\">\n        \"{{ $('Webhook Sales Trigger').first().json.body?.content || $('Webhook Sales Trigger').first().json.content || 'Yêu cầu tư vấn triển khai phần mềm CRM tự động' }}\"\n      </div>\n\n      <div style=\"text-align: center; margin-top: 24px;\">\n        <a href=\"http://localhost:3000/crm\" class=\"cta-btn\" target=\"_blank\">Mở Dashboard Xem Chi Tiết</a>\n      </div>\n    </div>\n    <div class=\"email-footer\">\n      NovaCRM Lead Engine • Tự động hóa tiếp nhận khách hàng thời gian thực.\n    </div>\n  </div>\n</body>\n</html>\n",
