    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst content = body.content || body.text || '';\nconst parts = content.split(/Trân trọng|Best regards|Thanks|Kính thư/i);\nreturn [{\n  json: {\n    ...body,\n    clean_body: parts[0] ? parts[0].trim() : content,\n    signature: parts[1] ? parts[1].trim() : ''\n  }\n}];"
      },
      "id": "06192d62-133d-4f4e-a862-a44cdf769252",
      "name": "Extract Signature Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1104,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst text = (item.clean_body + ' ' + item.signature);\nconst phoneMatch = text.match(/(\\+84|0)\\d{9,10}/);\nconst budgetMatch = text.match(/(\\d+)\\s*(tr|triệu|million|k)/i);\n\nreturn [{\n  json: {\n    ...item,\n    extracted_name: item.sender_name || 'Khách hàng',\n    extracted_phone: phoneMatch ? phoneMatch[0] : '0901234567',\n    extracted_company: item.company || 'Doanh nghiệp đối tác',\n    extracted_budget: budgetMatch ? 60000000 : 20000000,\n    extracted_requirement: item.subject || 'Quan tâm giải pháp phần mềm'\n  }\n}];"
      },
