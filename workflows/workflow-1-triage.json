    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body ? item.body : item;\nconst rawSender = payload.from || payload.sender || \"khachhang@congty.com\";\nconst cleanSender = rawSender.match(/<([^>]+)>/) ? rawSender.match(/<([^>]+)>/)[1] : rawSender;\nconst rawBody = payload.text || payload.body || \"\";\nconst cleanBody = String(rawBody).replace(/<[^>]*>?/gm, \"\").replace(/\\r?\\n|\\r/g, \" \").trim();\nconst cleanSubject = String(payload.subject || \"Yeu cau\").replace(/\\r?\\n|\\r/g, \" \").trim();\n\nreturn [{\n  json: {\n    sender_email: cleanSender.trim(),\n    subject: cleanSubject,\n    clean_body: cleanBody,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
