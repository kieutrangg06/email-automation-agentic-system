        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{\n    parts: [{\n      text: `Bạn là trợ lý AI điều phối email doanh nghiệp. Đọc tiêu đề và nội dung email sau:\nTiêu đề: ${$(\"3. Cleanse & Normalize Email\").first().json.subject}\nNội dung: ${$(\"3. Cleanse & Normalize Email\").first().json.clean_body}\n\nHãy phân loại chính xác và trả về JSON theo đúng định dạng sau:\n{\n  \"category\": \"Technical\" | \"Sales\" | \"Finance\" | \"General\",\n  \"priority\": \"P1 - Critical\" | \"P2 - High\" | \"P3 - Medium\" | \"P4 - Low\",\n  \"sentiment\": \"Khan cap\" | \"Tich cuc\" | \"Tieu cuc\" | \"Trung tinh\",\n  \"urgency_reason\": \"Lý do ngắn gọn bằng tiếng Việt\"\n}`\n    }]\n  }],\n  generationConfig: {\n    response_mime_type: \"application/json\"\n  }\n}) }}",
        "options": {}
      },
      "id": "node-7",
      "name": "7. AI Real Classifier Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1520,
        360
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const emailData = $(\"3. Cleanse & Normalize Email\").first().json;\nlet aiResult = {};\n\ntry {\n  const rawText = $input.first().json.candidates[0].content.parts[0].text;\n  aiResult = JSON.parse(rawText);\n} catch (e) {\n  const text = (emailData.subject + \" \" + emailData.clean_body).toLowerCase();\n  if (text.indexOf(\"lỗi\") !== -1 || text.indexOf(\"sập\") !== -1 || text.indexOf(\"504\") !== -1 || text.indexOf(\"database\") !== -1 || text.indexOf(\"khẩn cấp\") !== -1) {\n    aiResult = { category: \"Technical\", priority: \"P1 - Critical\", sentiment: \"Khan cap\", urgency_reason: \"Sự cố hạ tầng nghiêm trọng\" };\n  } else if (text.indexOf(\"báo giá\") !== -1 || text.indexOf(\"hợp đồng\") !== -1 || text.indexOf(\"mua\") !== -1) {\n    aiResult = { category: \"Sales\", priority: \"P2 - High\", sentiment: \"Tich cuc\", urgency_reason: \"Cơ hội kinh doanh tiềm năng\" };\n  } else if (text.indexOf(\"hóa đơn\") !== -1 || text.indexOf(\"thanh toán\") !== -1 || text.indexOf(\"vat\") !== -1) {\n    aiResult = { category: \"Finance\", priority: \"P3 - Medium\", sentiment: \"Trung tinh\", urgency_reason: \"Yêu cầu chứng từ đối soát\" };\n  } else {\n    aiResult = { category: \"General\", priority: \"P4 - Low\", sentiment: \"Trung tinh\", urgency_reason: \"Hỗ trợ thông tin chung\" };\n  }\n}\n\nreturn [{\n  json: {\n    ...emailData,\n    category: aiResult.category ? aiResult.category : \"General\",\n    priority: aiResult.priority ? aiResult.priority : \"P4 - Low\",\n    sentiment: aiResult.sentiment ? aiResult.sentiment : \"Trung tinh\",\n    urgency_reason: aiResult.urgency_reason ? aiResult.urgency_reason : \"Đã phân loại tự động\"\n  }\n}];"
      },
