    {
      "parameters": {
        "jsCode": "const emailItem = $(\"3. Cleanse & Normalize Email\").first().json;\n\nfunction removeVietnameseTones(str) {\n  return str.normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .replace(/đ/g, \"d\").replace(/Đ/g, \"D\")\n    .toLowerCase();\n}\n\nconst textSearch = removeVietnameseTones((emailItem.subject || \"\") + \" \" + (emailItem.clean_body || \"\"));\n\nlet category = \"General\";\nlet priority = \"P4 - Low\";\nlet sentiment = \"Tích cực\";\nlet reason = \"Yêu cầu thông tin thông thường\";\n\nif (textSearch.includes(\"khan cap\") || textSearch.includes(\"loi\") || textSearch.includes(\"sap\") || textSearch.includes(\"504\") || textSearch.includes(\"gateway\") || textSearch.includes(\"co so du lieu\")) {\n  category = \"Technical\";\n  priority = \"P1 - Critical\";\n  sentiment = \"Cần hỗ trợ gấp\";\n  reason = \"Sự cố hạ tầng hệ thống hoặc gián đoạn dịch vụ nghiêm trọng\";\n} else if (textSearch.includes(\"bao gia\") || textSearch.includes(\"mua\") || textSearch.includes(\"hop dong\") || textSearch.includes(\"demo\")) {\n  category = \"Sales\";\n  priority = \"P2 - High\";\n  sentiment = \"Hợp tác\";\n  reason = \"Yêu cầu tư vấn triển khai và báo giá hợp đồng thương mại\";\n} else if (textSearch.includes(\"hoa don\") || textSearch.includes(\"thanh toan\") || textSearch.includes(\"doi soat\") || textSearch.includes(\"vat\")) {\n  category = \"Finance\";\n  priority = \"P3 - Medium\";\n  sentiment = \"Hành chính\";\n  reason = \"Nghiệp vụ đối soát chứng từ và phát hành hóa đơn VAT\";\n}\n\nreturn [{\n  json: {\n    ...emailItem,\n    category,\n    priority,\n    sentiment,\n    urgency_reason: reason\n  }\n}];"
      },
