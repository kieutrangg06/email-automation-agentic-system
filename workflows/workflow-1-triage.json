      "id": "node-2",
      "name": "2. Filter Spam & Bounces",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body ? item.body : item;\nconst rawSender = payload.from ? payload.from : (payload.sender ? payload.sender : \"guest@enterprise.com\");\nconst senderMatch = rawSender.match(/<([^>]+)>/);\nconst cleanSender = senderMatch ? senderMatch[1] : rawSender;\nconst rawBody = payload.text ? payload.text : (payload.body ? payload.body : \"\");\nconst cleanBody = String(rawBody).replace(/<[^>]*>?/gm, \"\").replace(/\\r?\\n|\\r/g, \" \").trim();\nconst cleanSubject = String(payload.subject ? payload.subject : \"Yêu cầu hỗ trợ\").replace(/\\r?\\n|\\r/g, \" \").trim();\n\nreturn [{\n  json: {\n    sender_email: cleanSender.trim(),\n    subject: cleanSubject,\n    clean_body: cleanBody,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-3",
      "name": "3. Cleanse & Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
