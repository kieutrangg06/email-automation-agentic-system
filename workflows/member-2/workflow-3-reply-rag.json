        "jsCode": "const item=$input.first().json,p=item.body&&typeof item.body==='object'?item.body:item,saved=$('L3-09 Save Draft to Postgres').first().json,id=Number(p.draft_id),action=String(p.action||'').toUpperCase(),reviewed_by=String(p.reviewed_by||'').trim();if(!Number.isInteger(id)||id!==Number(saved.id))throw new Error('Approval draft_id mismatch');if(!['APPROVE','MODIFY'].includes(action))throw new Error('Invalid approval action');if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(reviewed_by))throw new Error('Invalid reviewer email');const subject=action==='MODIFY'?String(p.subject||'').trim():saved.proposed_subject,body=action==='MODIFY'?String(p.body||'').trim():saved.proposed_body;if(!subject||!body)throw new Error('Subject and body are required');return[{json:{draft_id:id,action,reviewed_by,subject,body,to:saved.recipient_email,ticket_code:saved.ticket_code}}];"
