      "parameters": {
        "jsCode": "const item=$input.first().json,p=item.body&&typeof item.body==='object'?item.body:item;const email=String(p.sender_email??p.from??'').trim(),subject=String(p.subject??'').trim();const body=String(p.body??p.text??p.clean_body??'').replace(/<[^>]*>/g,' ').replace(/&nbsp;|&#160;/gi,' ').replace(/&amp;/gi,'&').replace(/&lt;/gi,'<').replace(/&gt;/gi,'>').replace(/[\\u0000-\\u001f\\u007f]/g,' ').replace(/\\s+/g,' ').trim();if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))throw new Error('Invalid sender_email');if(!body)throw new Error('Email body is required');const words=(subject+' '+body).replace(/[^\\p{L}\\p{N}\\s'-]/gu,' ').match(/[\\p{L}\\p{N}][\\p{L}\\p{N}'-]{1,}/gu)||[];const stop=new Set(['the','and','for','you','are','this','that','with','from','have','your','cua','cho','mot','nhung','toi','ban','la','va','cac','duoc','xin','hoi','giup','ve','co','khong','nay']);const query_keywords=[...new Set(words.filter(w=>!stop.has(w.toLowerCase())).map(w=>w.trim()))].slice(0,40);return[{json:{ticket_code:String(p.ticket_code??'').trim()||null,sender_email:email,sender_name:String(p.sender_name??'').trim(),subject,body,received_at:p.received_at??new Date().toISOString(),message_id:String(p.message_id??'').trim(),query_keywords,search_text:query_keywords.join(' ')}}];"
      },
