    {
      "parameters": {
        "jsCode": "const d=$input.first().json;const normalized_query=d.search_text.normalize('NFKC').toLocaleLowerCase('vi').trim().replace(/[\\p{P}\\p{S}]+/gu,' ').replace(/\\s+/g,' ');return[{json:{...d,normalized_query}}];"
      },
