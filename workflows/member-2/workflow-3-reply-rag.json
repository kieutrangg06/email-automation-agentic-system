      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT kb.id,kb.topic,kb.keywords,kb.content,COUNT(*) AS match_count FROM knowledge_base kb JOIN LATERAL regexp_split_to_table($1, chr(32)) AS term ON length(term)>1 AND concat_ws(' ',kb.topic,kb.keywords,kb.content) ILIKE '%'||term||'%' GROUP BY kb.id,kb.topic,kb.keywords,kb.content,kb.created_at ORDER BY match_count DESC,kb.created_at DESC LIMIT 5;",
        "options": {
          "queryReplacement": "={{ [$json.normalized_query] }}"
        }
      },
