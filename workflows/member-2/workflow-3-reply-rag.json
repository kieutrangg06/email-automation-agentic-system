    {
      "parameters": {
        "jsCode": "const raw=$input.first().json,text=raw.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('').trim()||raw.text||'',clean=text.replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'').trim(),start=clean.indexOf('{'),end=clean.lastIndexOf('}');if(start<0||end<start)throw new Error('AI response did not contain JSON');let v;try{v=JSON.parse(clean.slice(start,end+1))}catch(e){throw new Error('AI JSON parse failed: '+e.message)}const proposed_subject=String(v.proposed_subject||'').trim(),proposed_body=String(v.proposed_body||'').trim(),confidence=Number(v.confidence);if(!proposed_subject||!proposed_body||!Number.isFinite(confidence))throw new Error('AI JSON missing required fields');return[{json:{...$('L3-05 Inject Knowledge Context').first().json,proposed_subject,proposed_body,confidence:Math.max(0,Math.min(100,Math.round(confidence)))}}];"
